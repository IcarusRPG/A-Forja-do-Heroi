    "test:mobile": "playwright test"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
